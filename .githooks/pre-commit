#!/usr/bin/env bash
# Runs the gate for whatever the staged changes touch. Install with just hooks.
# Skip once with git commit --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

changed=$(git diff --cached --name-only)

if grep -qE '^(apps/engine/|apps/cli/|Cargo\.(toml|lock)|clippy\.toml|rustfmt\.toml|scripts/)' <<<"$changed"; then
  echo "pre-commit: just check-rust"
  just check-rust
fi

if grep -qE '^apps/website/' <<<"$changed"; then
  echo "pre-commit: just check-website"
  just check-website
fi

exit 0
